{
  "schema_version": 1,
  "host": "linux_glibc_x86_64",
  "tools": [
    {
      "module": "dtc",
      "executable": "dtc",
      "licenses": ["external_dtc_license"],
      "probes": [
        {
          "args": ["--version"],
          "output_regex": "^Version: DTC v?1\\.8\\.1\\s*$"
        },
        {
          "args": ["--help"],
          "output_regex": "--symbols"
        }
      ]
    }
  ]
}
